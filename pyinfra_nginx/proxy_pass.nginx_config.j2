server {
    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /var/lib/acme/live/{{ domain }}/fullchain; # managed by acmetool
    ssl_certificate_key /var/lib/acme/live/{{ domain }}/privkey; # managed by acmetool

    server_name {{ domain }};
    client_max_body_size 512m;
    underscores_in_headers on;

    location / {
        proxy_set_header    Host                $http_host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $scheme;
        {{ websocket_config }}

        {% if not anubis %}
        proxy_pass http://127.0.0.1:{{ proxy_port }}/;
        {% else %}
        proxy_pass http://{{ domain }}-anubis;
        {% endif %}
	}
}

{% if anubis %}
server {
    listen unix:/run/anubis/{{ domain }}-nginx.sock;
    server_name {{ domain }};
    client_max_body_size 512m;
    underscores_in_headers on;

    location / {
        proxy_set_header    Host                $http_host;
        proxy_set_header    X-Real-IP           $http_x_real_ip;
        proxy_set_header    X-Forwarded-For     $http_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $http_x_forwarded_proto;

        proxy_pass http://127.0.0.1:{{ proxy_port }}/;
    }
}
upstream {{ domain }}-anubis {
    server unix:/run/anubis/{{ domain }}-anubis.sock;
}
{% endif %}
